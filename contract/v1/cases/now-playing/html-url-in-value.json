{
  "description": "A value carrying a web address is refused (trapped page)",
  "adapter": {
    "format": "12moon.now_playing/1",
    "station": "st_aaaaaaaaaaaaaaaaaaaaaaaaaa",
    "request": {
      "url": "https://www.kxmp.example.org/plays.php?feed=last&limit=3",
      "hosts": [
        "www.kxmp.example.org"
      ],
      "expect": "html"
    },
    "extract": {
      "items": "div.playlistitem",
      "pick": "first",
      "fields": {
        "artist": {
          "css": "span.artist",
          "trim": true
        },
        "title": {
          "css": "span.track",
          "trim": true
        },
        "started_at": {
          "css": "span.time",
          "regex": "@\\s*(\\d{1,2}:\\d{2})",
          "time": "local_hm",
          "timezone": "America/New_York"
        }
      }
    },
    "freshness": {
      "max_age_s": 600
    },
    "poll": {
      "interval_s": 60,
      "min_interval_s": 30
    },
    "ignore": {
      "equals_station_name": true
    },
    "limits": {
      "max_bytes": 65536,
      "timeout_ms": 8000
    }
  },
  "station_name": "",
  "response": {
    "content_type": "text/html",
    "body": "<html><body><div id=\"plays\"><div class=\"playlistitem\"><span class=\"artist\">Visit https://spam.example</span> <span class=\"track\">Song</span> <span class=\"time\">@3:41</span></div></div><script>var x = '<div class=\"playlistitem\">';</script></body></html>"
  },
  "now": "2026-11-08T08:44:35Z",
  "expected": {
    "error": "invalid_value"
  }
}
