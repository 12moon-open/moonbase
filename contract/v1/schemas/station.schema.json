{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.12moon.app/v1/schemas/station.schema.json",
  "title": "Station",
  "type": "object",
  "required": [
    "id",
    "rev",
    "status",
    "name",
    "streams",
    "sources",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^st_[0-9a-z]{26}$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "alt_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "lang": {
            "type": "string"
          }
        }
      }
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "subdivision": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
    },
    "place": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://"
    },
    "logo_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "protocol"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sm_[0-9a-z]{26}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^/@]+(/|$|\\?)"
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "codec": {
            "type": "string"
          },
          "bitrate_kbps": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "ids": {
      "type": "object",
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "radio_browser": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "radioarg": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ra:[a-z0-9-]{1,120}$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "retrieved_at"
        ],
        "properties": {
          "source": {
            "enum": [
              "radio-browser",
              "wikidata",
              "contribution",
              "editor",
              "radioarg"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "wikipedia": {
      "description": "Wikipedia article titles by language code, from Wikidata. The address is https://{lang}.wikipedia.org/wiki/{title}.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "active"
      }
    }
  },
  "then": {
    "properties": {
      "streams": {
        "minItems": 1
      }
    }
  }
}
