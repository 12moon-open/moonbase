{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.12moon.app/v1/schemas/station-proposal.schema.json",
  "title": "Station proposal",
  "description": "A station added by an installation. Published only after each stream has been checked, under the source contribution, in the public domain (CC0).",
  "type": "object",
  "required": ["kind", "name", "country", "streams", "consent"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "station_add" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": { "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://[^/@\\s]+(/|$|\\?)" } }
      }
    },
    "homepage": { "type": "string", "maxLength": 2000, "pattern": "^https?://[^/@\\s]+(/|$|\\?)" },
    "logo_url": { "type": "string", "maxLength": 2000, "pattern": "^https?://[^/@\\s]+(/|$|\\?)" },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "dependentRequired": { "lat": ["lon"], "lon": ["lat"] }
    },
    "languages": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z]{2,3}$" } },
    "tags": { "description": "Only from contract/v1/tags.json.", "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1 } },
    "consent": { "const": "CC0-1.0" }
  }
}
