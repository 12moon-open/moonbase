{
  "format": "12moon.now_playing_template/1",
  "id": "npr.cadence/1",
  "status": "active",
  "terms": {
    "robots_txt": "https://cadence.nprstations.org/robots.txt",
    "checked_at": "2026-11-08",
    "basis": "public_page"
  },
  "params": {
    "channel": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "request": {
    "url": "https://cadence.nprstations.org/api/cadence/widget/{channel}?show_song=true",
    "hosts": [
      "cadence.nprstations.org"
    ],
    "expect": "json"
  },
  "extract": {
    "items": "$.currentlyPlayingSong",
    "pick": "first",
    "fields": {
      "artist": {
        "path": "$.artist",
        "list": "first",
        "or_paths": [
          "$.ensemble",
          "$.composer"
        ]
      },
      "title": {
        "path": "$.title"
      },
      "album": {
        "path": "$.album"
      },
      "started_at": {
        "path": "$.start.utc",
        "time": "iso8601"
      },
      "ended_at": {
        "path": "$.end.utc",
        "time": "iso8601"
      },
      "show": {
        "path": "$.onNow.programName",
        "root": true
      }
    }
  },
  "freshness": {
    "max_age_s": 1800,
    "grace_after_end_s": 60
  },
  "poll": {
    "interval_s": 60,
    "min_interval_s": 30
  },
  "limits": {
    "max_bytes": 262144,
    "timeout_ms": 8000
  }
}
