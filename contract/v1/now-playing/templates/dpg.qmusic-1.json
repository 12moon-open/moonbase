{
  "format": "12moon.now_playing_template/1",
  "id": "dpg.qmusic/1",
  "status": "active",
  "terms": {
    "robots_txt": "https://api.qmusic.nl/robots.txt",
    "checked_at": "2026-11-08",
    "basis": "public_page"
  },
  "params": {
    "station": {
      "pattern": "^[a-z0-9_]{1,40}$"
    }
  },
  "request": {
    "url": "https://api.qmusic.nl/2.4/tracks/plays?limit=1&_station_id={station}",
    "hosts": [
      "api.qmusic.nl"
    ],
    "expect": "json"
  },
  "extract": {
    "items": "$.played_tracks[*]",
    "pick": "first",
    "fields": {
      "artist": {
        "path": "$.artist.name"
      },
      "title": {
        "path": "$.title"
      },
      "started_at": {
        "path": "$.played_at",
        "time": "iso8601"
      }
    }
  },
  "freshness": {
    "max_age_s": 900
  },
  "poll": {
    "interval_s": 60,
    "min_interval_s": 30
  },
  "limits": {
    "max_bytes": 262144,
    "timeout_ms": 8000
  }
}
